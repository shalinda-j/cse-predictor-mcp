# CSE Predictor MCP Server Configuration
# All settings are optional; sensible defaults are shown.

# CSE public API base URL (override only if the CSE changes its API host)
CSE_API_URL=https://www.cse.lk/api

# HTTP request timeout for CSE API calls, in milliseconds (default: 20000)
CSE_REQUEST_TIMEOUT_MS=20000

# Trading days of history to use for analysis (default: 365)
CSE_HISTORY_DAYS=365

# Where the SQLite prediction-tracking database is stored (default: ./data)
CSE_DATA_PATH=./data

# Enable verbose/debug logging (default: false)
CSE_VERBOSE_LOGGING=false
